{
  "name": "portfolio-cinematic",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "check:budgets": "node scripts/check-budgets.mjs",
    "format": "prettier --write src tests scripts/*.mjs *.ts *.json *.md",
    "check": "npm run lint && npm run test && npm run build && npm run check:budgets",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.2",
    "jsdom": "^30.0.1",
    "oxlint": "^1.69.0",
    "postcss": "^8.5.15",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^5.0.0"
  }
}
